// Адаптировано под Charybdis (перенос с QMK keymap.c)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>

// Индексы слоёв
#define BASE        0
#define GAME        1
#define GAME_EXTRA  2
#define LOWER       3
#define LOWER_EXTRA 4
#define UPPER       5
#define ADJUST      6
#define POINTER     7

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER UPPER>;
            then-layer = <ADJUST>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_6 {
            timeout-ms = <50>;
            key-positions = <1 3>;
            layers = <LOWER>;
            bindings = <&kp N6>;
        };
        combo_7 {
            timeout-ms = <50>;
            key-positions = <2 3>;
            layers = <LOWER>;
            bindings = <&kp N7>;
        };
        combo_8 {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <LOWER>;
            bindings = <&kp N8>;
        };
        combo_9 {
            timeout-ms = <50>;
            key-positions = <1 2 3>;
            layers = <LOWER>;
            bindings = <&kp N9>;
        };
        combo_0 {
            timeout-ms = <50>;
            key-positions = <0 3>;
            layers = <LOWER>;
            bindings = <&kp N0>;
        };

        combo_f6 {
            timeout-ms = <50>;
            key-positions = <1 3>;
            layers = <UPPER>;
            bindings = <&kp F6>;
        };
        combo_f7 {
            timeout-ms = <50>;
            key-positions = <2 3>;
            layers = <UPPER>;
            bindings = <&kp F7>;
        };
        combo_f8 {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <UPPER>;
            bindings = <&kp F8>;
        };
        combo_f9 {
            timeout-ms = <50>;
            key-positions = <1 2 3>;
            layers = <UPPER>;
            bindings = <&kp F9>;
        };
        combo_f10 {
            timeout-ms = <50>;
            key-positions = <0 3>;
            layers = <UPPER>;
            bindings = <&kp F10>;
        };
        combo_f11 {
            timeout-ms = <50>;
            key-positions = <0 2 3>;
            layers = <UPPER>;
            bindings = <&kp F11>;
        };
        combo_f12 {
            timeout-ms = <50>;
            key-positions = <0 1 3>;
            layers = <UPPER>;
            bindings = <&kp F12>;
        };

        combo_to_adjust {
            timeout-ms = <50>;
            key-positions = <33 34>;
            layers = <BASE>;
            bindings = <&mo ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I  &kp O  &kp P
                &kp A  &kp S  &kp D  &kp F  &kp G    &kp H  &kp J  &kp K  &kp L  &kp SCLN
                &kp Z  &kp X  &kp C  &kp V  &kp B    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                              &mo LOWER  &mo UPPER    &kp LSHFT  &kp SPACE
            >;
        };

        game {
            display-name = "Game";
            bindings = <
                &kp M  &kp Q  &kp W  &kp E  &kp R    &none  &none  &kp UP  &none  &none
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F    &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none
                &mo LOWER  &kp Z  &kp X  &kp C  &kp V    &none  &mkp MB1  &mkp MB3  &mkp MB2  &kp C_SCRL
                              &mo GAME_EXTRA  &kp SPACE    &to 0  &mo GAME_EXTRA
            >;
        };

        game_extra {
            display-name = "Game Extra";
            bindings = <
                &kp P  &kp O  &kp U  &kp Y  &kp T    &none  &none  &none  &none  &none
                &kp LCTRL  &kp L  &kp J  &kp H  &kp G    &none  &none  &none  &none  &none
                &kp I  &kp K  &kp M  &kp N  &kp B    &none  &none  &none  &none  &none
                              &trans  &none    &none  &none
            >;
        };

        lower {
            display-name = "Lower";
            bindings = <
                &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
                &mo LOWER_EXTRA  &kp DOWN  &kp UP  &kp BSPC  &kp DEL    &kp GRAVE  &kp MINUS  &kp EQUAL  &kp BSLH  &kp SQT
                &kp LCTRL  &kp LEFT  &kp RIGHT  &kp SCLN  &none    &none  &kp LBKT  &none  &none  &kp RBKT
                              &trans  &mo UPPER    &kp LSHFT  &kp SPACE
            >;
        };

        lower_extra {
            display-name = "Lower Extra";
            bindings = <
                &kp INS  &none  &none  &kp C_MPLY  &kp C_MPRV    &kp KP_SLASH  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_ASTERISK
                &trans  &kp PG_DN  &kp PG_UP  &kp CAPS  &to 1    &kp KP_MINUS  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
                &kp C_SLEP  &kp HOME  &kp END  &kp C_VOL_DN  &kp C_VOL_UP    &kp KP_N0  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT
                              &kp C_MNXT  &kp SPACE    &kp KP_NLCK  &kp RALT
            >;
        };

        upper {
            display-name = "Upper";
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &mo ADJUST  &kp LALT  &kp LCTRL  &none  &kp TAB    &kp F11  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI
                &kp LSHFT  &kp LCTRL  &kp ESC  &kp K_CMENU  &kp LGUI    &kp F12  &mkp MB1  &mkp MB3  &mkp MB2  &kp C_SCRL
                              &none  &to 0    &kp LSHFT  &kp SPACE
            >;
        };

        adjust {
            display-name = "Adjust";
            bindings = <
                &none  &none  &none  &none  &none    &none  &none  &none  &sys_reset  &bootloader
                &none  &none  &none  &none  &none    &none  &none  &none  &trans  &none
                &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
                              &none  &none    &none  &none
            >;
        };

        pointer {
            display-name = "Pointer";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &kp C_SCRL
                              &trans  &trans    &trans  &trans
            >;
        };
    };
};