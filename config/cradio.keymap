// Адаптировано под Charybdis (перенос с QMK keymap.c)
// + Leader Key

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // ==========================================================
    // LEADER KEY (модуль zmk-leader-key от urob)
    // ==========================================================
    behaviors {
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;

            // Leader, V -> Copy/Paste
            copy_paste {
                sequence = <V>;
                bindings = <&macro_copy_paste>;
            };

            // Leader, D -> Save/Close
            save_close {
                sequence = <D>;
                bindings = <&macro_save_close>;
            };

            // Leader, S -> Language swap
            lang_swap {
                sequence = <S>;
                bindings = <&macro_lang_swap>;
            };
        };
    };

    // ==========================================================
    // МАКРОСЫ (для Leader Key)
    // ==========================================================
    macros {
        // Leader, V => Ctrl+C, Alt+Tab, Enter, Ctrl+V, Alt+Tab
        macro_copy_paste: macro_copy_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &kp LCTRL &kp C
                &kp LALT &kp TAB
                &kp ENTER
                &kp LCTRL &kp V
                &kp LALT &kp TAB
            >;
        };

        // Leader, D => Ctrl+S, Enter, Ctrl+W
        macro_save_close: macro_save_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &kp LCTRL &kp S
                &kp ENTER
                &kp LCTRL &kp W
            >;
        };

        // Leader, S => Win+Space
        macro_lang_swap: macro_lang_swap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LGUI &kp SPACE>;
        };
    };

    // ==========================================================
    // КОМБО
    // ==========================================================
    combos {
        compatible = "zmk,combos";

        // Цифры на LOWER (слой 3)
        combo_6 {
            timeout-ms = <50>;
            key-positions = <1 3>;
            layers = <3>;
            bindings = <&kp N6>;
        };
        combo_7 {
            timeout-ms = <50>;
            key-positions = <2 4>;
            layers = <3>;
            bindings = <&kp N7>;
        };
        combo_8 {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <3>;
            bindings = <&kp N8>;
        };
        combo_9 {
            timeout-ms = <50>;
            key-positions = <3 4>;
            layers = <3>;
            bindings = <&kp N9>;
        };
        combo_0 {
            timeout-ms = <50>;
            key-positions = <0 4>;
            layers = <3>;
            bindings = <&kp N0>;
        };

        // F-клавиши на UPPER (слой 5)
        combo_f6 {
            timeout-ms = <50>;
            key-positions = <1 3>;
            layers = <5>;
            bindings = <&kp F6>;
        };
        combo_f7 {
            timeout-ms = <50>;
            key-positions = <2 4>;
            layers = <5>;
            bindings = <&kp F7>;
        };
        combo_f8 {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <5>;
            bindings = <&kp F8>;
        };
        combo_f9 {
            timeout-ms = <50>;
            key-positions = <3 4>;
            layers = <5>;
            bindings = <&kp F9>;
        };
        combo_f10 {
            timeout-ms = <50>;
            key-positions = <0 4>;
            layers = <5>;
            bindings = <&kp F10>;
        };
        combo_f11 {
            timeout-ms = <50>;
            key-positions = <0 2>;
            layers = <5>;
            bindings = <&kp F11>;
        };
        combo_f12 {
            timeout-ms = <50>;
            key-positions = <0 1>;
            layers = <5>;
            bindings = <&kp F12>;
        };

        // Быстрый ADJUST на BASE (слой 0)
        combo_to_adjust {
            timeout-ms = <50>;
            key-positions = <33 34>;
            layers = <0>;
            bindings = <&mo 6>;
        };
    };

    // ==========================================================
    // KEYMAP
    // ==========================================================
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I  &kp O  &kp P
                &kp A  &kp S  &kp D  &kp F  &kp G    &kp H  &kp J  &kp K  &kp L  &kp SEMICOLON
                &kp Z  &kp X  &kp C  &kp V  &kp B    &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH
                              &mo 3  &mo 5    &kp LSHFT  &kp SPACE
            >;
        };

        game {
            display-name = "Game";
            bindings = <
                &kp M  &kp Q  &kp W  &kp E  &kp R    &none  &none  &kp UP  &none  &none
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F    &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none
                &mo 3  &kp Z  &kp X  &kp C  &kp V    &none  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans
                              &mo 2  &kp SPACE    &to 0  &mo 2
            >;
        };

        game_extra {
            display-name = "Game Extra";
            bindings = <
                &kp P  &kp O  &kp U  &kp Y  &kp T    &none  &none  &none  &none  &none
                &kp LCTRL  &kp L  &kp J  &kp H  &kp G    &none  &none  &none  &none  &none
                &kp I  &kp K  &kp M  &kp N  &kp B    &none  &none  &none  &none  &none
                              &trans  &none    &none  &none
            >;
        };

        lower {
            display-name = "Lower";
            bindings = <
                &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
                &mo 4  &kp DOWN  &kp UP  &kp BACKSPACE  &kp DELETE    &kp GRAVE  &kp MINUS  &kp EQUAL  &kp BACKSLASH  &kp SINGLE_QUOTE
                &kp LCTRL  &kp LEFT  &kp RIGHT  &kp SEMICOLON  &none    &none  &kp LBKT  &none  &none  &kp RBKT
                              &trans  &mo 5    &kp LSHFT  &kp SPACE
            >;
        };

        lower_extra {
            display-name = "Lower Extra";
            bindings = <
                &kp INSERT  &none  &none  &kp C_PLAY_PAUSE  &kp C_PREVIOUS    &kp KP_SLASH  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_ASTERISK
                &trans  &kp PAGE_DOWN  &kp PAGE_UP  &kp CAPSLOCK  &to 1    &kp KP_MINUS  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
                &kp C_SLEEP  &kp HOME  &kp END  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP    &kp KP_N0  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT
                              &kp C_NEXT  &kp SPACE    &kp KP_NUM  &kp RIGHT_ALT
            >;
        };

        upper {
            display-name = "Upper";
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &mo 6  &kp LEFT_ALT  &kp LEFT_CONTROL  &leader  &kp TAB    &kp F11  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI
                &kp LSHFT  &kp LCTRL  &kp ESCAPE  &kp K_CMENU  &kp LEFT_GUI    &kp F12  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans
                              &none  &to 0    &kp LSHFT  &kp SPACE
            >;
        };

        adjust {
            display-name = "Adjust";
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_NXT  &bt BT_PRV  &bt BT_CLR  &bt BT_CLR_ALL  &out OUT_TOG
                &sys_reset  &bootloader  &none  &none  &none    &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
                              &none  &none    &none  &none
            >;
        };

        pointer {
            display-name = "Pointer";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans
                              &trans  &trans    &trans  &trans
            >;
        };
    };
};