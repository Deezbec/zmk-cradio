// Шаг 1: pointing.h + все слои
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I  &kp O  &kp P
                &kp A  &kp S  &kp D  &kp F  &kp G    &kp H  &kp J  &kp K  &kp L  &kp SEMICOLON
                &kp Z  &kp X  &kp C  &kp V  &kp B    &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH
                              &mo 3  &mo 5    &kp LSHFT  &kp SPACE
            >;
        };

        game {
            display-name = "Game";
            bindings = <
                &kp M  &kp Q  &kp W  &kp E  &kp R    &none  &none  &kp UP  &none  &none
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F    &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none
                &mo 3  &kp Z  &kp X  &kp C  &kp V    &none  &trans  &trans  &trans  &trans
                              &mo 2  &kp SPACE    &to 0  &mo 2
            >;
        };

        game_extra {
            display-name = "Game Extra";
            bindings = <
                &kp P  &kp O  &kp U  &kp Y  &kp T    &none  &none  &none  &none  &none
                &kp LCTRL  &kp L  &kp J  &kp H  &kp G    &none  &none  &none  &none  &none
                &kp I  &kp K  &kp M  &kp N  &kp B    &none  &none  &none  &none  &none
                              &trans  &none    &none  &none
            >;
        };

        lower {
            display-name = "Lower";
            bindings = <
                &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
                &mo 4  &kp DOWN  &kp UP  &kp BACKSPACE  &kp DELETE    &kp GRAVE  &kp MINUS  &kp EQUAL  &kp BACKSLASH  &kp SINGLE_QUOTE
                &kp LCTRL  &kp LEFT  &kp RIGHT  &kp SEMICOLON  &none    &none  &kp LBKT  &none  &none  &kp RBKT
                              &trans  &mo 5    &kp LSHFT  &kp SPACE
            >;
        };

        lower_extra {
            display-name = "Lower Extra";
            bindings = <
                &kp INSERT  &none  &none  &kp C_PLAY_PAUSE  &kp C_PREVIOUS    &kp KP_SLASH  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_ASTERISK
                &trans  &kp PAGE_DOWN  &kp PAGE_UP  &kp CAPSLOCK  &to 1    &kp KP_MINUS  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
                &kp C_SLEEP  &kp HOME  &kp END  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP    &kp KP_N0  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT
                              &kp C_NEXT  &kp SPACE    &kp KP_NUM  &kp RIGHT_ALT
            >;
        };

        upper {
            display-name = "Upper";
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &mo 6  &kp LEFT_ALT  &kp LEFT_CONTROL  &none  &kp TAB    &kp F11  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI
                &kp LSHFT  &kp LCTRL  &kp ESCAPE  &kp K_CMENU  &kp LEFT_GUI    &kp F12  &trans  &trans  &trans  &trans
                              &none  &to 0    &kp LSHFT  &kp SPACE
            >;
        };

        adjust {
            display-name = "Adjust";
            bindings = <
                &none  &none  &none  &none  &none    &none  &none  &none  &sys_reset  &bootloader
                &none  &none  &none  &none  &none    &none  &none  &none  &trans  &none
                &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
                              &none  &none    &none  &none
            >;
        };

        pointer {
            display-name = "Pointer";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                              &trans  &trans    &trans  &trans
            >;
        };
    };
};в